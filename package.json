{
  "name": "web-coding",
  "private": true,
  "version": "0.1.0",
  "description": "Standalone multi-channel requirement runner and Codex Web CLI",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "db:status": "node src/cli/database.cjs status",
    "db:migrate": "node src/cli/database.cjs migrate",
    "db:seed": "node src/cli/database.cjs seed",
    "db:seed:fixtures": "node src/cli/seed-fixtures.cjs",
    "accounts:init": "node src/cli/accounts.cjs init",
    "accounts:reset": "node src/cli/accounts.cjs reset",
    "tapd:session": "node src/cli/tapd/capture-session.cjs",
    "tapd:auth:cookie": "node src/cli/tapd/auth-cookie.cjs",
    "tapd:todo": "node src/cli/tapd/search.cjs",
    "tapd:search": "node src/cli/tapd/search.cjs --type story",
    "tapd:detail": "node src/cli/tapd/detail.cjs",
    "tapd:task": "node src/cli/tapd/task.cjs",
    "tapd:users": "node src/cli/tapd/users.cjs",
    "tapd:transitions": "node src/cli/tapd/transitions.cjs",
    "tapd:transition": "node src/cli/tapd/transitions.cjs --apply",
    "tapd:run": "node src/cli/tapd/run.cjs",
    "tapd:retry-transition": "node src/cli/tapd/run.cjs --retry-transition",
    "tapd:status": "node src/cli/tapd/run.cjs --status",
    "lint": "eslint src test web/src web/vite.config.mjs",
    "test": "node --test test/architecture/*.test.cjs test/unit/*.test.cjs test/integration/*.test.cjs",
    "test:web": "node test/browser/session.cjs && node test/browser/workspaces.cjs && node test/browser/dev.cjs && node test/browser/accounts.cjs",
    "test:visual": "node test/browser/visual.cjs",
    "verify": "npm run lint && npm test && npm run build && npm run test:web && npm run test:visual",
    "web:build": "vite build --config web/vite.config.mjs",
    "dev": "node src/cli/dev.cjs",
    "dev:watch": "node src/cli/dev-watch.cjs",
    "tapd:web": "npm run web:build && node src/cli/web.cjs",
    "build": "npm run web:build",
    "start": "node src/cli/web.cjs"
  },
  "dependencies": {
    "@antdv-next/icons": "1.1.2",
    "@fastify/cookie": "11.1.2",
    "@fastify/csrf-protection": "8.0.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/session": "11.1.3",
    "antdv-next": "1.2.0",
    "better-sqlite3": "13.0.3",
    "dompurify": "3.4.15",
    "fastify": "5.12.5",
    "knex": "3.3.0",
    "marked": "16.4.2",
    "pinyin-pro": "3.29.4",
    "playwright": "1.59.1",
    "vue": "^3.5.32",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.6",
    "eslint": "10.2.0",
    "eslint-plugin-vue": "10.8.0",
    "prettier": "3.8.3",
    "vite": "8.0.16",
    "vue-eslint-parser": "10.4.0"
  }
}
