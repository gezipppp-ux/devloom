{
  "name": "web-coding",
  "private": true,
  "version": "0.1.0",
  "description": "Standalone multi-channel requirement runner and Codex Web CLI",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup:link": "node --env-file-if-exists=.env src/cli/setup-link.cjs",
    "init:admin": "node --env-file-if-exists=.env src/cli/init-admin.cjs",
    "dev": "node --env-file-if-exists=.env src/cli/dev.cjs",
    "dev:watch": "node --env-file-if-exists=.env src/cli/dev-watch.cjs",
    "db:generate": "node --env-file-if-exists=.env ./node_modules/prisma/build/index.js generate && tsc -p tsconfig.prisma.json",
    "db:deploy": "node --env-file-if-exists=.env ./node_modules/prisma/build/index.js migrate deploy",
    "build": "npm run db:generate && vite build --config web/vite.config.mjs",
    "start": "node --env-file-if-exists=.env src/cli/web.cjs"
  },
  "dependencies": {
    "@antdv-next/icons": "1.1.2",
    "@fastify/cookie": "11.1.2",
    "@fastify/csrf-protection": "8.0.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/session": "11.1.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/vue-3": "3.31.4",
    "antdv-next": "1.2.0",
    "diff": "^9.0.0",
    "dompurify": "3.4.15",
    "fastify": "5.12.5",
    "highlight.js": "^11.12.0",
    "marked": "16.4.2",
    "pg": "8.23.1",
    "pinyin-pro": "3.29.4",
    "playwright": "1.59.1",
    "vue": "^3.5.32",
    "vue-router": "4.6.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@vitejs/plugin-vue": "6.0.6",
    "eslint": "10.2.0",
    "eslint-plugin-vue": "10.8.0",
    "prettier": "3.8.3",
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vue-eslint-parser": "10.4.0"
  }
}
